# Copy this file to .env.local and fill in your values.

# Google Maps Embed API key (client-side — must be NEXT_PUBLIC_).
# Enable "Maps Embed API" in Google Cloud Console, then paste the key.
# Restrict the key to your domain(s) in the console for safety.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# WhatsApp Business number for the floating chat widget.
# Digits only, including country code, no + or spaces (e.g. 919000187731).
# Defaults to the site business number if left blank.
NEXT_PUBLIC_WHATSAPP_NUMBER=
